+DisplayUpdateResult Uc8279X4Driver::displayChecked(EpdBus& bus, const uint8_t* fb, const uint8_t* prev,
+                                                   RefreshMode mode, bool turnOff) {
+  (void)prev;
+  const uint32_t startedAt = millis();
+  beginTrace(DisplayTracePhase::Full, 0, 0, _w, _h, bus.isBusy());
+  if (fb == nullptr) {
+    traceStage(DisplayTraceStage::Validate);
+    traceError(DisplayUpdateError::InvalidRegion);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Full, DisplayUpdateKind::None, DisplayUpdateError::InvalidRegion,
+            DisplayUpdateFallback::None, 0};
+  }
+  if (!checkedDisplayReady(bus)) {
+    traceStage(DisplayTraceStage::Preflight);
+    traceError(DisplayUpdateError::BusyNotReady);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Full, DisplayUpdateKind::None, DisplayUpdateError::BusyNotReady,
+            DisplayUpdateFallback::None, 0};
+  }
+
+  // A full checked refresh is the only recovery operation. Force the next
+  // displayStart() through the controller's absolute GC path while either the
+  // latch or the host/controller baseline says that OLD RAM is unknown.
+  if (_checkedRecoveryRequired || _windowBaselineState != WindowBaselineState::Valid) {
+    _needFullClear = true;
+    _oldPlaneValid = false;
+    _redriveAfterGray = false;
+    if (mode == RefreshMode::Fast) mode = RefreshMode::Full;
+  }
+  _windowBaselineState = WindowBaselineState::Resyncing;
+  _checkedWindowActive = false;
+  _checkedOperationActive = true;
+  bus.beginCheckedOperation();
+  const bool started = displayStart(bus, fb, nullptr, mode, turnOff);
+  if (started) displayFinish(bus, fb);
+  _checkedOperationActive = false;
+  const bool busSucceeded = bus.endCheckedOperation();
+  const uint32_t duration = static_cast<uint32_t>(millis() - startedAt);
+
+  if (!started || !busSucceeded) {
+    _checkedRecoveryRequired = true;
+    _needFullClear = true;
+    _oldPlaneValid = false;
+    _isScreenOn = false;
+    _windowBaselineState = WindowBaselineState::Invalid;
+    _lastTrace.wait = DisplayTraceWait::TimedOut;
+    traceError(DisplayUpdateError::BusyTimeout);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Full,
+            _lastTrace.refreshTriggered ? DisplayUpdateKind::Full : DisplayUpdateKind::None,
+            DisplayUpdateError::BusyTimeout, DisplayUpdateFallback::None, duration};
+  }
+
+  traceStage(DisplayTraceStage::PostWriteReady);
+  _lastTrace.wait = DisplayTraceWait::Ready;
+  if (bus.isBusy()) {
+    _checkedRecoveryRequired = true;
+    _needFullClear = true;
+    _oldPlaneValid = false;
+    _windowBaselineState = WindowBaselineState::Invalid;
+    traceError(DisplayUpdateError::BusyNotReady);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Full,
+            _lastTrace.refreshTriggered ? DisplayUpdateKind::Full : DisplayUpdateKind::None,
+            DisplayUpdateError::BusyNotReady, DisplayUpdateFallback::None, duration};
+  }
+
+  _checkedRecoveryRequired = false;
+  _windowBaselineState = turnOff ? WindowBaselineState::Invalid : WindowBaselineState::Valid;
+  traceStage(DisplayTraceStage::Complete);
+  finishTrace(bus);
+  return {DisplayUpdateKind::Full, DisplayUpdateKind::Full, DisplayUpdateError::None, DisplayUpdateFallback::None,
+          duration};
+}
