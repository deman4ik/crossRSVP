+bool Uc8253X3Driver::prepareCheckedDisplay(EpdBus& bus, const uint8_t* fb, RefreshMode mode, bool turnOff,
+                                           bool* doFullSync, bool* fastMode) {
+  if (!fb || !doFullSync || !fastMode) return false;
+  if (_checkedRecoveryRequired) bus.cmd(CMD_PARTIAL_OUT);
+  if (!_isScreenOn && !turnOff) mode = RefreshMode::Half;
+  if (_inGrayscaleMode) {
+    _inGrayscaleMode = false;
+    _grayState = {};
+    _redRamSynced = false;
+  }
+
+  *fastMode = mode == RefreshMode::Fast;
+  const bool halfMode = mode == RefreshMode::Half;
+  const bool forcedFullSync = _forceFullSyncNext;
+  *doFullSync = (!*fastMode && !halfMode) || !_redRamSynced || _initialFullSyncsRemaining > 0 || forcedFullSync;
+  const bool doHalfSync = halfMode && !*doFullSync;
+  _grayState.lastBaseWasPartial = !*doFullSync;
+
+  if (*doFullSync) {
+    loadBankCdi(bus, 0x29, 0x07, _cfg.full);
+    bus.fillPlane(CMD_DTM1, 0xFF, _h, _wb);
+    bus.cmd(CMD_DATA_STOP);
+    bus.sendPlaneFlipped(CMD_DTM2, fb, _h, _wb);
+  } else if (doHalfSync) {
+    loadBankCdi(bus, 0xA9, 0x07, _cfg.half);
+    bus.sendPlaneFlipped(CMD_DTM2, fb, _h, _wb);
+  } else {
+    loadBankCdi(bus, 0x29, 0x07, _cfg.fast);
+    bus.sendPlaneFlipped(CMD_DTM2, fb, _h, _wb);
+  }
+  return true;
+}
+
+BusyWaitStatus Uc8253X3Driver::finishCheckedDisplay(EpdBus& bus, const uint8_t* fb, bool doFullSync, bool fastMode,
+                                                    bool turnOff, bool* refreshTriggered) {
+  if (triggerRefreshChecked(bus, turnOff, refreshTriggered) != BusyWaitStatus::Ready) return BusyWaitStatus::TimedOut;
+  if (!fastMode) delay(200);
+
+  uint8_t postConditionPasses = 0;
+  if (doFullSync) {
+    if (_forceFullSyncNext)
+      postConditionPasses = _forcedConditionPassesNext;
+    else if (_initialFullSyncsRemaining == 1)
+      postConditionPasses = 1;
+  }
+  if (postConditionPasses > 0) {
+    const uint16_t xEnd = static_cast<uint16_t>(_w - 1);
+    const uint16_t yEnd = static_cast<uint16_t>(_h - 1);
+    const uint8_t window[9] = {0x00, 0x00, static_cast<uint8_t>(xEnd >> 8), static_cast<uint8_t>(xEnd & 0xFF),
+                               0x00, 0x00, static_cast<uint8_t>(yEnd >> 8), static_cast<uint8_t>(yEnd & 0xFF),
+                               0x01};
+    loadBankCdi(bus, 0xA9, 0x07, _cfg.normal);
+    for (uint8_t i = 0; i < postConditionPasses; ++i) {
+      bus.cmd(CMD_PARTIAL_IN);
+      bus.cmdData(CMD_PARTIAL_WINDOW, window, sizeof(window));
+      bus.sendPlaneFlipped(CMD_DTM2, fb, _h, _wb);
+      bus.cmd(CMD_PARTIAL_OUT);
+      if (triggerRefreshChecked(bus, false, refreshTriggered) != BusyWaitStatus::Ready) return BusyWaitStatus::TimedOut;
+    }
+  }
+
+  bus.sendPlaneFlipped(CMD_DTM1, fb, _h, _wb);
+  bus.cmd(CMD_DATA_STOP);
+  _grayState.lsbValid = false;
+  _redRamSynced = true;
+
+  if (doFullSync) {
+    loadBankCdi(bus, 0x29, 0x07, _cfg.fast);
+    bus.sendPlaneFlipped(CMD_DTM2, fb, _h, _wb);
+    if (triggerRefreshChecked(bus, turnOff, refreshTriggered) != BusyWaitStatus::Ready) return BusyWaitStatus::TimedOut;
+    bus.sendPlaneFlipped(CMD_DTM1, fb, _h, _wb);
+    bus.cmd(CMD_DATA_STOP);
+  }
+
+  if (doFullSync && _initialFullSyncsRemaining > 0) --_initialFullSyncsRemaining;
+  _forceFullSyncNext = false;
+  _forcedConditionPassesNext = 0;
+  return BusyWaitStatus::Ready;
+}
