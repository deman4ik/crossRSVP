+void Ssd1677Driver::writeWindowRam(EpdBus& bus, uint8_t ramCmd, const uint8_t* frame, uint16_t x, uint16_t y,
+                                   uint16_t w, uint16_t h) {
+  if (frame == nullptr || w == 0 || h == 0) return;
+  const uint16_t widthBytes = static_cast<uint16_t>(w / 8);
+  const uint16_t xByte = static_cast<uint16_t>(x / 8);
+  bus.cmd(ramCmd);
+  // SSD1677's Y data-entry direction is decrementing after setRamArea(). The
+  // legacy window path emits logical rows in ascending order, which therefore
+  // lands in the controller's reversed gate range. Keep that order while
+  // streaming directly from the full framebuffer (no packed heap scratch).
+  bus.beginTxn();
