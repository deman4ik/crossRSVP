+DisplayUpdateResult Uc8253X3Driver::displayWindowChecked(EpdBus& bus, const uint8_t* fb, const uint8_t* prev,
+                                                         uint16_t x, uint16_t y, uint16_t w, uint16_t h, bool turnOff) {
+  (void)prev;
+  const uint32_t startedAt = millis();
+  beginTrace(bus, DisplayTracePhase::Window, x, y, w, h);
+  if (!fb || w == 0 || h == 0 || x % 8 != 0 || w % 8 != 0 || x >= _w || y >= _h || w > _w - x || h > _h - y) {
+    traceStage(DisplayTraceStage::Validate);
+    traceError(DisplayUpdateError::InvalidRegion);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Window, DisplayUpdateKind::None, DisplayUpdateError::InvalidRegion,
+            DisplayUpdateFallback::None, 0};
+  }
+  if (!checkedDisplayReady(bus)) {
+    traceStage(DisplayTraceStage::Preflight);
+    traceError(DisplayUpdateError::BusyNotReady);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Window, DisplayUpdateKind::None, DisplayUpdateError::BusyNotReady,
+            DisplayUpdateFallback::None, 0};
+  }
+  if (_windowBaselineState != WindowBaselineState::Valid || _checkedRecoveryRequired || _inGrayscaleMode) {
+    DisplayUpdateResult fallback = displayChecked(bus, fb, nullptr, RefreshMode::Fast, turnOff);
+    fallback.requestedKind = DisplayUpdateKind::Window;
+    fallback.fallback = DisplayUpdateFallback::BaselineInvalid;
+    return fallback;
+  }
+
+  const uint16_t xEnd = static_cast<uint16_t>(x + w - 1);
+  const uint16_t yEnd = static_cast<uint16_t>(y + h - 1);
+  const uint16_t gateYStart = static_cast<uint16_t>((_h - 1) - yEnd);
+  const uint16_t gateYEnd = static_cast<uint16_t>((_h - 1) - y);
+  const uint8_t window[9] = {static_cast<uint8_t>(x >> 8),
+                             static_cast<uint8_t>(x & 0xFF),
+                             static_cast<uint8_t>(xEnd >> 8),
+                             static_cast<uint8_t>(xEnd & 0xFF),
+                             static_cast<uint8_t>(gateYStart >> 8),
+                             static_cast<uint8_t>(gateYStart & 0xFF),
+                             static_cast<uint8_t>(gateYEnd >> 8),
+                             static_cast<uint8_t>(gateYEnd & 0xFF),
+                             0x01};
+
+  _windowBaselineState = WindowBaselineState::Resyncing;
+  traceBaseline(WindowBaselineState::Resyncing);
+  bus.beginCheckedOperation();
+  // Keep the controller's full-width RAM cursor contract: the X3 portrait line
+  // is narrow in physical X but spans the full gate range, so a host-side
+  // narrow-X payload would exercise an unverified stride convention.
+  traceStage(DisplayTraceStage::FullDtm2);
+  bus.sendPlaneFlipped(CMD_DTM2, fb, _h, _wb);
+  tracePayload(_bufferSize);
+  traceStage(DisplayTraceStage::PartialIn);
+  bus.cmd(CMD_PARTIAL_IN);
+  traceStage(DisplayTraceStage::PartialWindow);
+  bus.cmdData(CMD_PARTIAL_WINDOW, window, sizeof(window));
+  traceStage(DisplayTraceStage::RefreshSetup);
+  loadBankCdi(bus, 0x29, 0x07, _cfg.fast);
+  bool refreshTriggered = false;
+  const BusyWaitStatus waitStatus = triggerRefreshChecked(bus, turnOff, &refreshTriggered);
+  bool readyAfter = false;
+  if (waitStatus == BusyWaitStatus::Ready) {
+    traceStage(DisplayTraceStage::PartialOut);
+    bus.cmd(CMD_PARTIAL_OUT);
+    traceStage(DisplayTraceStage::FullDtm1);
+    bus.sendPlaneFlipped(CMD_DTM1, fb, _h, _wb);
+    tracePayload(_bufferSize);
+    traceStage(DisplayTraceStage::DataStop);
+    bus.cmd(CMD_DATA_STOP);
+    traceStage(DisplayTraceStage::PostWriteReady);
+    readyAfter = !bus.isBusy();
+  }
+  const bool busSucceeded = bus.endCheckedOperation();
+  const uint32_t duration = static_cast<uint32_t>(millis() - startedAt);
+  if (waitStatus != BusyWaitStatus::Ready || !busSucceeded) {
+    _checkedRecoveryRequired = true;
+    _redRamSynced = false;
+    invalidateWindowBaseline();
+    traceError(DisplayUpdateError::BusyTimeout);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Window, refreshTriggered ? DisplayUpdateKind::Window : DisplayUpdateKind::None,
+            DisplayUpdateError::BusyTimeout, DisplayUpdateFallback::None, duration};
+  }
+  if (!readyAfter) {
+    _checkedRecoveryRequired = true;
+    _redRamSynced = false;
+    invalidateWindowBaseline();
+    traceError(DisplayUpdateError::BusyNotReady);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Window, refreshTriggered ? DisplayUpdateKind::Window : DisplayUpdateKind::None,
+            DisplayUpdateError::BusyNotReady, DisplayUpdateFallback::None, duration};
+  }
+
+  _checkedRecoveryRequired = false;
+  _windowBaselineState = turnOff ? WindowBaselineState::Invalid : WindowBaselineState::Valid;
+  _redRamSynced = !turnOff;
+  traceStage(DisplayTraceStage::Complete);
+  traceBaseline(_windowBaselineState);
+  finishTrace(bus);
+  return {DisplayUpdateKind::Window, DisplayUpdateKind::Window, DisplayUpdateError::None, DisplayUpdateFallback::None,
+          duration};
+}
