+    traceError(DisplayUpdateError::BusyNotReady);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Full,
+            _lastTrace.refreshTriggered ? DisplayUpdateKind::Full : DisplayUpdateKind::None,
+            DisplayUpdateError::BusyNotReady, DisplayUpdateFallback::None, duration};
+  }
+
+  _lastTrace.wait = DisplayTraceWait::Ready;
+  _checkedRecoveryRequired = false;
+  _windowBaselineState = turnOff ? WindowBaselineState::Invalid : WindowBaselineState::Valid;
+  traceStage(DisplayTraceStage::Complete);
+  finishTrace(bus);
+  return {DisplayUpdateKind::Full, DisplayUpdateKind::Full, DisplayUpdateError::None, DisplayUpdateFallback::None,
