+  _checkedWindowActive = false;
+  const bool busSucceeded = bus.endCheckedOperation();
+  const uint32_t duration = static_cast<uint32_t>(millis() - startedAt);
+
+  if (!started || !busSucceeded) {
+    _checkedRecoveryRequired = true;
+    _needFullClear = true;
+    _oldPlaneValid = false;
+    _isScreenOn = false;
+    _windowBaselineState = WindowBaselineState::Invalid;
+    _lastTrace.wait = DisplayTraceWait::TimedOut;
