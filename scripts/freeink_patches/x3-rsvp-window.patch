+BusyWaitStatus EpdBus::waitBusyChecked(const char* tag) { return waitBusyChecked(_busy, tag); }
+
+BusyWaitStatus EpdBus::waitBusyChecked(BusyPolarity p, const char* tag) {
+  const unsigned long start = millis();
+  bool longWait = false;
+  bool hookFired = false;
+  bool timedOut = false;
+
+  const auto idle = [&](uint8_t busyLevel, uint8_t fallbackDelayMs) {
+    busyIdle(longWait, busyLevel, fallbackDelayMs);
+    if (!longWait && millis() - start > BUSY_WAIT_HOOK_THRESHOLD_MS) {
+      longWait = true;
+      if (_busyWaitBeginHook != nullptr) {
+        hookFired = true;
+        _busyWaitBeginHook();
+      }
+    }
+  };
+
+  if (p == BusyPolarity::ActiveHigh) {
+    while (digitalRead(_pins.busy) == HIGH) {
+      idle(HIGH, 1);
+      if (millis() - start > 30000) {
+        timedOut = true;
+        break;
+      }
+    }
+  } else if (p == BusyPolarity::ActiveLow) {
+    bool busy = digitalRead(_pins.busy) == LOW;
+    if (!busy) {
+      while (millis() - start < 100) {
+        if (digitalRead(_pins.busy) == LOW) {
+          busy = true;
+          break;
+        }
+        delay(1);
+      }
+    }
+    while (busy && digitalRead(_pins.busy) == LOW) {
+      idle(LOW, 10);
+      if (millis() - start > 30000) {
+        timedOut = true;
+        break;
+      }
+    }
+  } else if (p == BusyPolarity::UcIdleHigh) {
+    delay(1);
+    while (digitalRead(_pins.busy) == LOW) {
+      idle(LOW, 1);
+      if (millis() - start > 30000) {
+        timedOut = true;
+        break;
+      }
+    }
+  } else {
+    while (digitalRead(_pins.busy) == HIGH && millis() - start <= 1000) delay(1);
+    if (digitalRead(_pins.busy) != LOW) {
+      timedOut = true;
+    } else {
+      while (digitalRead(_pins.busy) == LOW) {
+        idle(LOW, 1);
+        if (millis() - start > 30000) {
+          timedOut = true;
+          break;
+        }
+      }
+    }
+  }
+
+  if (hookFired && _busyWaitEndHook != nullptr) _busyWaitEndHook();
+  if (tag && Serial) {
+    Serial.printf("[%lu]   Wait %s: %s (%lu ms)\n", millis(), timedOut ? "timeout" : "complete", tag, millis() - start);
+  }
+  if (timedOut) recordWaitFailure();
+  return timedOut ? BusyWaitStatus::TimedOut : BusyWaitStatus::Ready;
+}
