+DisplayUpdateResult FreeInkDisplay::displayWindowChecked(uint16_t x, uint16_t y, uint16_t w, uint16_t h,
+                                                         bool turnOffScreen) {
+  _facadeTrace = {};
+  const bool busyBefore = _driver != nullptr && _bus.isBusy();
+  if (frameBuffer == nullptr || w == 0 || h == 0 || x % 8 != 0 || w % 8 != 0 || x >= displayWidth ||
+      y >= displayHeight || w > displayWidth - x || h > displayHeight - y) {
+    const auto baseline = windowBaselineState();
+    recordEarlyTrace(_facadeTrace, DisplayTracePhase::Window, DisplayTraceStage::Validate,
+                     DisplayUpdateError::InvalidRegion, baseline, windowBaselineState(), busyBefore,
+                     _driver != nullptr && _bus.isBusy(), x, y, w, h);
+    return {DisplayUpdateKind::Window, DisplayUpdateKind::None, DisplayUpdateError::InvalidRegion,
+            DisplayUpdateFallback::None, 0};
+  }
+  if (!checkedDisplayReady()) {
+    const auto baseline = windowBaselineState();
+    recordEarlyTrace(_facadeTrace, DisplayTracePhase::Window, DisplayTraceStage::Preflight,
+                     DisplayUpdateError::BusyNotReady, baseline, windowBaselineState(), busyBefore,
+                     _driver != nullptr && _bus.isBusy(), x, y, w, h);
+    return {DisplayUpdateKind::Window, DisplayUpdateKind::None, DisplayUpdateError::BusyNotReady,
+            DisplayUpdateFallback::None, 0};
+  }
+
+  DisplayUpdateFallback facadeFallback = DisplayUpdateFallback::None;
+  if (_inverted || _inversionDirty)
+    facadeFallback = DisplayUpdateFallback::Inverted;
+  else if (!_experimentalWindowUpdates)
+    facadeFallback = DisplayUpdateFallback::ExperimentalDisabled;
+  else if (!_driver->supportsExperimentalWindowUpdates())
+    facadeFallback = DisplayUpdateFallback::UnsupportedDriver;
+
+  if (facadeFallback != DisplayUpdateFallback::None) {
+    DisplayUpdateResult result = displayBufferChecked(FAST_REFRESH, turnOffScreen);
+    result.requestedKind = DisplayUpdateKind::Window;
+    result.fallback = facadeFallback;
+    return result;
+  }
+
+  cancelGrayscalePass();
+  _grayPassFailed = false;
+#ifdef EINK_DISPLAY_SINGLE_BUFFER_MODE
+  DisplayUpdateResult result = _driver->displayWindowChecked(_bus, frameBuffer, nullptr, x, y, w, h, turnOffScreen);
+  _shadowValid = false;
+#else
+  DisplayUpdateResult result =
+      _driver->displayWindowChecked(_bus, frameBuffer, frameBufferActive, x, y, w, h, turnOffScreen);
+  if (result.succeeded() && result.actualKind == DisplayUpdateKind::Full) swapBuffers();
+#endif
+  if (!result.succeeded()) invalidateWindowBaseline();
+  _facadeTrace = _driver != nullptr ? _driver->lastDisplayUpdateTrace() : DisplayUpdateTrace{};
+  return result;
+}
