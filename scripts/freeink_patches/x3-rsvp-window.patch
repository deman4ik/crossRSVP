+    finishTrace(bus);
+    return {DisplayUpdateKind::Window,
+            _lastTrace.refreshTriggered ? DisplayUpdateKind::Window : DisplayUpdateKind::None,
+            DisplayUpdateError::BusyNotReady, DisplayUpdateFallback::None, duration};
+  }
+
+  _checkedRecoveryRequired = false;
+  _windowBaselineState = turnOff ? WindowBaselineState::Invalid : WindowBaselineState::Valid;
+  traceStage(DisplayTraceStage::Complete);
+  finishTrace(bus);
+  return {DisplayUpdateKind::Window, DisplayUpdateKind::Window, DisplayUpdateError::None, DisplayUpdateFallback::None,
+          duration};
