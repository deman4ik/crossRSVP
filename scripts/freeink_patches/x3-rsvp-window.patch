+#pragma once
+
+#include <Arduino.h>
+
+namespace freeink {
+
+enum class DisplayUpdateKind : uint8_t { None, Full, Window };
+
+enum class DisplayUpdateError : uint8_t { None, InvalidRegion, BusyNotReady, BusyTimeout };
+
+enum class DisplayUpdateFallback : uint8_t {
+  None,
+  ExperimentalDisabled,
+  UnsupportedDriver,
+  Inverted,
+  BaselineInvalid,
+};
+
+enum class WindowBaselineState : uint8_t { Invalid, Resyncing, Valid };
+
+enum class DisplayTracePhase : uint8_t { None, Full, Window };
+
+enum class DisplayTraceStage : uint8_t {
+  None,
+  Validate,
+  Preflight,
+  FullDtm2,
+  PartialIn,
+  PartialWindow,
+  RefreshSetup,
+  PowerOn,
+  PowerOnWait,
+  RefreshCommand,
+  RefreshWait,
+  PowerOff,
+  PowerOffWait,
+  PartialOut,
+  FullDtm1,
+  DataStop,
+  PostWriteReady,
+  Complete,
+};
+
+enum class DisplayTraceWait : uint8_t { None, Ready, TimedOut };
+
+struct DisplayUpdateTrace {
+  // This is one fixed last-operation snapshot. payloadBytes counts only bytes
+  // sent to DTM1/DTM2; busyAfter is an immediate tail sample and cannot prove
+  // that BUSY will remain idle after this function returns.
+  bool valid = false;
+  DisplayTracePhase phase = DisplayTracePhase::None;
+  DisplayTraceStage stage = DisplayTraceStage::None;
+  DisplayUpdateError error = DisplayUpdateError::None;
+  DisplayTraceWait wait = DisplayTraceWait::None;
+  bool busyBefore = false;
+  bool busyAfter = false;
+  WindowBaselineState baselineBefore = WindowBaselineState::Invalid;
+  WindowBaselineState baselineAfter = WindowBaselineState::Invalid;
+  uint16_t x = 0;
+  uint16_t y = 0;
+  uint16_t width = 0;
+  uint16_t height = 0;
+  uint32_t payloadBytes = 0;
+  bool refreshTriggered = false;
+};
+
+struct DisplayUpdateResult {
+  DisplayUpdateKind requestedKind = DisplayUpdateKind::None;
+  DisplayUpdateKind actualKind = DisplayUpdateKind::None;
+  DisplayUpdateError error = DisplayUpdateError::None;
+  DisplayUpdateFallback fallback = DisplayUpdateFallback::None;
+  uint32_t durationMs = 0;
+
+  bool succeeded() const { return error == DisplayUpdateError::None && actualKind != DisplayUpdateKind::None; }
+};
+
+}  // namespace freeink
