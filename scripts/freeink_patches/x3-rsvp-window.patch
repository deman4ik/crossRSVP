+BusyWaitStatus EpdBus::waitRefreshCompleteChecked(const char* tag) {
+  const unsigned long start = millis();
+  const bool activeHigh = (_busy == BusyPolarity::ActiveHigh);
+  const int activeLevel = activeHigh ? HIGH : LOW;
+  const unsigned long startGrace =
+      _busy == BusyPolarity::ActiveHigh ? 20
+      : _busy == BusyPolarity::UcIdleHigh ? 50
+      : _busy == BusyPolarity::X3TwoPhase ? 1000
+                                          : 100;
+
+  // A refresh command may assert BUSY a few microseconds after MASTER_ACTIVATION.
+  // Poll the active level for a short, controller-specific grace period before
+  // declaring a no-op. This edge qualification is the key distinction from the
+  // legacy idle-level wait: an already-idle line cannot falsely validate a
+  // checked refresh. The X3 two-phase value is included for callers that use
+  // this helper directly; its production path still uses waitBusyChecked().
+  bool sawActive = digitalRead(_pins.busy) == activeLevel;
+  while (!sawActive && millis() - start < startGrace) {
+    delayMicroseconds(200);
+    sawActive = digitalRead(_pins.busy) == activeLevel;
+  }
+  if (!sawActive) {
+    recordWaitFailure();
+    if (tag && Serial) {
+      Serial.printf("[%lu]   Wait timeout (no BUSY start): %s (%lu ms)\n", millis(), tag, millis() - start);
+    }
+    return BusyWaitStatus::TimedOut;
+  }
+
+  bool longWait = false;
+  bool hookFired = false;
+  while (digitalRead(_pins.busy) == activeLevel) {
+    busyIdle(longWait, static_cast<uint8_t>(activeLevel), activeHigh ? 1 : 10);
+    if (!longWait && millis() - start > BUSY_WAIT_HOOK_THRESHOLD_MS) {
+      longWait = true;
+      if (_busyWaitBeginHook != nullptr) {
+        hookFired = true;
+        _busyWaitBeginHook();
+      }
+    }
+    if (millis() - start > 30000) {
+      if (hookFired && _busyWaitEndHook != nullptr) _busyWaitEndHook();
+      recordWaitFailure();
+      if (tag && Serial) {
+        Serial.printf("[%lu]   Wait timeout (BUSY stuck): %s (%lu ms)\n", millis(), tag, millis() - start);
+      }
+      return BusyWaitStatus::TimedOut;
+    }
+  }
+
+  if (hookFired && _busyWaitEndHook != nullptr) _busyWaitEndHook();
+  if (tag && Serial) {
+    Serial.printf("[%lu]   Wait complete: %s (%lu ms)\n", millis(), tag, millis() - start);
+  }
+  return BusyWaitStatus::Ready;
+}
