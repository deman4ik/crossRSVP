+DisplayUpdateResult Ssd1677Driver::displayWindowChecked(EpdBus& bus, const uint8_t* fb, const uint8_t* prev,
+                                                        uint16_t x, uint16_t y, uint16_t w, uint16_t h,
+                                                        bool turnOff) {
+  const uint32_t startedAt = millis();
+  beginTrace(DisplayTracePhase::Window, x, y, w, h, bus.isBusy());
+  if (fb == nullptr || w == 0 || h == 0 || x % 8 != 0 || w % 8 != 0 || x >= _w || y >= _h || w > _w - x ||
+      h > _h - y) {
+    traceStage(DisplayTraceStage::Validate);
+    traceError(DisplayUpdateError::InvalidRegion);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Window, DisplayUpdateKind::None, DisplayUpdateError::InvalidRegion,
+            DisplayUpdateFallback::None, 0};
+  }
+  if (!checkedDisplayReady(bus)) {
+    traceStage(DisplayTraceStage::Preflight);
+    traceError(DisplayUpdateError::BusyNotReady);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Window, DisplayUpdateKind::None, DisplayUpdateError::BusyNotReady,
+            DisplayUpdateFallback::None, 0};
+  }
+  if (_checkedRecoveryRequired || _windowBaselineState != WindowBaselineState::Valid || _inGrayscaleMode ||
+      _needsGrayClear) {
+    DisplayUpdateResult fallback = displayChecked(bus, fb, nullptr, RefreshMode::Fast, turnOff);
+    fallback.requestedKind = DisplayUpdateKind::Window;
+    fallback.fallback = DisplayUpdateFallback::BaselineInvalid;
+    return fallback;
+  }
+
+  _windowBaselineState = WindowBaselineState::Resyncing;
+  traceStage(DisplayTraceStage::FullDtm2);
+  bus.beginCheckedOperation();
+  _checkedOperationActive = true;
+  setRamArea(bus, x, y, w, h);
+  writeWindowRam(bus, CMD_WRITE_RAM_BW, fb, x, y, w, h);
+  tracePayload(static_cast<uint32_t>(w / 8) * h);
+  if (prev != nullptr) {
+    traceStage(DisplayTraceStage::FullDtm1);
+    writeWindowRam(bus, CMD_WRITE_RAM_RED, prev, x, y, w, h);
+    tracePayload(static_cast<uint32_t>(w / 8) * h);
+  }
+  traceStage(DisplayTraceStage::RefreshSetup);
+  refresh(bus, RefreshMode::Fast, turnOff, /*async=*/false);
+
+  // The SSD1677 controller keeps the host-managed RED plane as the old image
+  // for a differential refresh. In single-buffer mode, re-seed both planes
+  // after the waveform; in dual-buffer mode the caller supplied `prev` above.
+  if (!bus.checkedOperationFailed()) {
+    if (prev == nullptr) {
+      traceStage(DisplayTraceStage::FullDtm1);
+      setRamArea(bus, x, y, w, h);
+      writeWindowRam(bus, CMD_WRITE_RAM_BW, fb, x, y, w, h);
+      tracePayload(static_cast<uint32_t>(w / 8) * h);
+      writeWindowRam(bus, CMD_WRITE_RAM_RED, fb, x, y, w, h);
+      tracePayload(static_cast<uint32_t>(w / 8) * h);
+    }
+    if (_pendingPowerOff) {
+      _pendingPowerOff = false;
+      powerOffController(bus);
+    }
+  }
+  _checkedOperationActive = false;
+  const bool busSucceeded = bus.endCheckedOperation();
+  const uint32_t duration = static_cast<uint32_t>(millis() - startedAt);
+  if (!busSucceeded) {
+    _checkedRecoveryRequired = true;
+    _pendingPowerOff = false;
+    _isScreenOn = false;
+    _windowBaselineState = WindowBaselineState::Invalid;
+    _lastTrace.wait = DisplayTraceWait::TimedOut;
+    traceError(DisplayUpdateError::BusyTimeout);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Window,
+            _lastTrace.refreshTriggered ? DisplayUpdateKind::Window : DisplayUpdateKind::None,
+            DisplayUpdateError::BusyTimeout, DisplayUpdateFallback::None, duration};
+  }
+  traceStage(DisplayTraceStage::PostWriteReady);
+  if (bus.isBusy()) {
+    _checkedRecoveryRequired = true;
+    _windowBaselineState = WindowBaselineState::Invalid;
+    _lastTrace.wait = DisplayTraceWait::Ready;
+    traceError(DisplayUpdateError::BusyNotReady);
+    finishTrace(bus);
+    return {DisplayUpdateKind::Window,
+            _lastTrace.refreshTriggered ? DisplayUpdateKind::Window : DisplayUpdateKind::None,
+            DisplayUpdateError::BusyNotReady, DisplayUpdateFallback::None, duration};
+  }
+
+  _lastTrace.wait = DisplayTraceWait::Ready;
+  _checkedRecoveryRequired = false;
+  _windowBaselineState = turnOff ? WindowBaselineState::Invalid : WindowBaselineState::Valid;
+  traceStage(DisplayTraceStage::Complete);
+  finishTrace(bus);
+  return {DisplayUpdateKind::Window, DisplayUpdateKind::Window, DisplayUpdateError::None, DisplayUpdateFallback::None,
+          duration};
+}
