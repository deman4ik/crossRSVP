+DisplayUpdateResult FreeInkDisplay::displayBufferChecked(RefreshMode mode, bool turnOffScreen) {
+  _facadeTrace = {};
+  cancelGrayscalePass();
+  _grayPassFailed = false;
+  const bool busyBefore = _driver != nullptr && _bus.isBusy();
+  if (frameBuffer == nullptr) {
+    const auto baseline = windowBaselineState();
+    recordEarlyTrace(_facadeTrace, DisplayTracePhase::Full, DisplayTraceStage::Validate,
+                     DisplayUpdateError::InvalidRegion, baseline, windowBaselineState(), busyBefore,
+                     _driver != nullptr && _bus.isBusy(), 0, 0, displayWidth, displayHeight);
+    return {DisplayUpdateKind::Full, DisplayUpdateKind::None, DisplayUpdateError::InvalidRegion,
+            DisplayUpdateFallback::None, 0};
+  }
+  if (!checkedDisplayReady()) {
+    const auto baseline = windowBaselineState();
+    recordEarlyTrace(_facadeTrace, DisplayTracePhase::Full, DisplayTraceStage::Preflight,
+                     DisplayUpdateError::BusyNotReady, baseline, windowBaselineState(), busyBefore,
+                     _driver != nullptr && _bus.isBusy(), 0, 0, displayWidth, displayHeight);
+    return {DisplayUpdateKind::Full, DisplayUpdateKind::None, DisplayUpdateError::BusyNotReady,
+            DisplayUpdateFallback::None, 0};
+  }
+  if (_inversionDirty && mode == FAST_REFRESH) mode = HALF_REFRESH;
+
+#ifdef EINK_DISPLAY_SINGLE_BUFFER_MODE
+  if (_inverted) invertBytes(frameBuffer, bufferSize);
+  DisplayUpdateResult result = _driver->displayChecked(_bus, frameBuffer, nullptr, toInternal(mode), turnOffScreen);
+  if (_inverted) invertBytes(frameBuffer, bufferSize);
+  _shadowValid = false;
+#else
+  const RefreshMode effectiveMode = resolveReleasedMode(mode);
+  uint8_t* const next = frameBuffer;
+  const uint8_t* const prev = consumePrevFrameFor(effectiveMode);
+  if (_inverted) {
+    invertBytes(next, bufferSize);
+    invertBytes(const_cast<uint8_t*>(prev), bufferSize);
+  }
+  DisplayUpdateResult result = _driver->displayChecked(_bus, next, prev, toInternal(effectiveMode), turnOffScreen);
+  if (_inverted) {
+    invertBytes(next, bufferSize);
+    invertBytes(const_cast<uint8_t*>(prev), bufferSize);
+  }
+  if (result.succeeded()) swapBuffers();
+#endif
+
+  if (result.succeeded()) {
