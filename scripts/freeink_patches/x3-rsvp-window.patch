+DisplayUpdateResult Uc8253X3Driver::displayChecked(EpdBus& bus, const uint8_t* fb, const uint8_t* prev,
+                                                   RefreshMode mode, bool turnOff) {
+  (void)prev;
+  const uint32_t startedAt = millis();
+  if (!fb) {
+    return {DisplayUpdateKind::Full, DisplayUpdateKind::None, DisplayUpdateError::InvalidRegion,
+            DisplayUpdateFallback::None, 0};
+  }
+  if (!checkedDisplayReady(bus)) {
+    return {DisplayUpdateKind::Full, DisplayUpdateKind::None, DisplayUpdateError::BusyNotReady,
+            DisplayUpdateFallback::None, 0};
+  }
+
+  if (_windowBaselineState != WindowBaselineState::Valid) _redRamSynced = false;
+  _windowBaselineState = WindowBaselineState::Resyncing;
+  bus.beginCheckedOperation();
+  bool doFullSync = false;
+  bool fastMode = false;
+  bool refreshTriggered = false;
+  const bool prepared = prepareCheckedDisplay(bus, fb, mode, turnOff, &doFullSync, &fastMode);
+  const BusyWaitStatus waitStatus =
+      prepared ? finishCheckedDisplay(bus, fb, doFullSync, fastMode, turnOff, &refreshTriggered)
+               : BusyWaitStatus::TimedOut;
+  const bool busSucceeded = bus.endCheckedOperation();
+  const uint32_t duration = static_cast<uint32_t>(millis() - startedAt);
+  if (!prepared || waitStatus != BusyWaitStatus::Ready || !busSucceeded) {
+    _checkedRecoveryRequired = true;
+    _redRamSynced = false;
+    invalidateWindowBaseline();
+    return {DisplayUpdateKind::Full, refreshTriggered ? DisplayUpdateKind::Full : DisplayUpdateKind::None,
+            DisplayUpdateError::BusyTimeout, DisplayUpdateFallback::None, duration};
+  }
+
+  _checkedRecoveryRequired = false;
+  _windowBaselineState = turnOff ? WindowBaselineState::Invalid : WindowBaselineState::Valid;
+  return {DisplayUpdateKind::Full, DisplayUpdateKind::Full, DisplayUpdateError::None, DisplayUpdateFallback::None,
+          duration};
+}
